# Git normalizes line endings to LF in the repository and converts to the
# platform's native endings on checkout.
* text=auto

# zig fmt rejects CRLF, so these must be LF on every platform, Windows CI
# included.
*.zig text eol=lf
*.zon text eol=lf
*.yml text eol=lf
*.sh text eol=lf
*.json text eol=lf

# Never normalized, never merged, never shown as text.
*.ico binary
*.png binary
